# Application Settings
NODE_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
POSTGRES_USER=fmp_admin
POSTGRES_PASSWORD=fmp_secret_pass_dev
POSTGRES_DB=fmp_dev
DATABASE_URL="postgresql://fmp_admin:fmp_secret_pass_dev@localhost:5432/fmp_dev?schema=public"

# Redis Cache & Ephemeral Store
REDIS_PASSWORD=fmp_redis_pass_dev
REDIS_URL="redis://:fmp_redis_pass_dev@localhost:6379/0"

# Authentication & Session Security (Min 32-byte secret for JWT/HMAC signing)
AUTH_SECRET="dev_super_secret_session_key_replace_in_production_min_32_chars"

# Football Data Provider API (Opta / API-Football)
FOOTBALL_DATA_API_KEY="your_football_api_key_here"
FOOTBALL_DATA_PROVIDER="api-football"

# AI Inspection & Editorial Service (OpenAI / DeepSeek)
AI_API_KEY="your_ai_api_key_here"
AI_API_ENDPOINT="https://api.openai.com/v1"

# Media Object Storage (S3 / Cloudflare R2)
STORAGE_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
STORAGE_BUCKET="fmp-media-assets"
STORAGE_ACCESS_KEY="your_storage_access_key"
STORAGE_SECRET_KEY="your_storage_secret_key"
