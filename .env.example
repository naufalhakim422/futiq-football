# ==============================================================================
# FOOTBALL MEDIA PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment ("development" | "production" | "test")
NODE_ENV=production

# Canonical Domain URL (Required for deterministic SEO, Canonical tags, OpenGraph)
APP_URL=https://football.example.com
NEXT_PUBLIC_APP_URL=https://football.example.com

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=fmp_admin
POSTGRES_PASSWORD=replace_with_strong_random_password_min_32_chars
POSTGRES_DB=fmp_production
DATABASE_URL="postgresql://fmp_admin:replace_with_strong_random_password_min_32_chars@postgres:5432/fmp_production?schema=public&sslmode=prefer"

# ------------------------------------------------------------------------------
# 2. REDIS CACHE & EPHEMERAL STORE (Redis 7)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_strong_redis_password_min_32_chars
REDIS_URL="redis://:replace_with_strong_redis_password_min_32_chars@redis:6379/0"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY (Min 32-byte secret for JWT/HMAC)
# ------------------------------------------------------------------------------
AUTH_SECRET="replace_with_super_secret_session_key_min_32_chars"

# ------------------------------------------------------------------------------
# 4. FOOTBALL DATA ENGINE
# ------------------------------------------------------------------------------
FOOTBALL_DATA_PROVIDER="mock" # "mock" | "api-football" | "opta"
FOOTBALL_DATA_API_KEY="replace_with_real_football_api_key"

# ------------------------------------------------------------------------------
# 5. AI EDITORIAL GATE & COPYRIGHT INSPECTION
# ------------------------------------------------------------------------------
AI_API_PROVIDER="mock" # "mock" | "openai" | "deepseek"
AI_API_KEY="replace_with_real_ai_api_key"
AI_API_ENDPOINT="https://api.openai.com/v1"

# ------------------------------------------------------------------------------
# 6. KYC & IDENTITY VERIFICATION
# ------------------------------------------------------------------------------
KYC_PROVIDER="mock-kyc-provider" # "mock-kyc-provider" | "sumsub" | "veriff"
KYC_PROVIDER_KEY="replace_with_kyc_provider_key"
KYC_WEBHOOK_SECRET="replace_with_kyc_webhook_hmac_secret"

# ------------------------------------------------------------------------------
# 7. AUTOMATIC PAYOUT GATEWAY
# ------------------------------------------------------------------------------
PAYOUT_PROVIDER="mock-payout-provider" # "mock-payout-provider" | "stripe" | "curlec" | "billplz"
PAYOUT_PROVIDER_KEY="replace_with_payout_provider_key"
PAYOUT_WEBHOOK_SECRET="replace_with_payout_webhook_hmac_secret"

# ------------------------------------------------------------------------------
# 8. S3 / OBJECT STORAGE (Media Assets & Featured Images)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_BUCKET="fmp-media-production"
STORAGE_ACCESS_KEY="replace_with_storage_access_key"
STORAGE_SECRET_KEY="replace_with_storage_secret_key"

# ------------------------------------------------------------------------------
# 9. INTERNAL SCHEDULER & CRON SECURITY
# ------------------------------------------------------------------------------
CRON_SECRET="replace_with_cron_authorization_secret"
