// Prisma Schema for Football Media Platform
// Sprint 1: User Identity & RBAC
// Sprint 2: Football Data Engine (Competitions, Seasons, Teams, Stadiums, Managers, Players, Matches, Events, Lineups, Standings, Stats, Transfers)
// Sprint 3: Contributor Platform (Profiles, Applications, Agreements, Articles, Sources, Revisions, Submissions, Reviews, Notifications, Analytics)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. RBAC & USER IDENTITY ENUMS & MODELS
// ==========================================

enum RoleType {
  SUPER_ADMIN
  EDITOR_IN_CHIEF
  SENIOR_EDITOR
  FINANCE
  CONTRIBUTOR
  READER
}

model User {
  id                 String                    @id @default(cuid())
  email              String                    @unique
  passwordHash       String?
  fullName           String
  avatarUrl          String?
  isActive           Boolean                   @default(true)
  isVerified         Boolean                   @default(false)
  roles              UserRole[]
  contributorProfile ContributorProfile?
  applications       ContributorApplication[]
  agreements         ContributorAgreement[]
  articles           Article[]
  editorialReviews   EditorialReview[]
  notifications      ContributorNotification[]
  overrideLogs          EditorialOverrideLog[]
  favoriteTeams         UserFavoriteTeam[]
  favoritePlayers       UserFavoritePlayer[]
  favoriteCompetitions  UserFavoriteCompetition[]
  notificationPreference NotificationPreference?
  createdAt             DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([email])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        RoleType         @unique
  description String
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([code])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ==========================================
// 2. FOOTBALL DATA ENGINE ENUMS & MODELS
// ==========================================

enum CompetitionType {
  LEAGUE
  CUP
  INTERNATIONAL
}

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  ATTACKER
}

enum MatchStatus {
  SCHEDULED
  LIVE_1H
  HT
  LIVE_2H
  ET
  PENALTY
  FINISHED
  POSTPONED
  CANCELLED
}

enum EventType {
  GOAL
  ASSIST
  YELLOW_CARD
  RED_CARD
  SUBSTITUTION
  VAR
  PENALTY_MISSED
  OWN_GOAL
}

enum TransferType {
  PERMANENT
  LOAN
  FREE_AGENT
}

enum TransferStatus {
  RUMOR
  ADVANCED
  COMPLETED
}

model Competition {
  id          String              @id @default(cuid())
  externalId  String?             @unique
  slug        String              @unique
  name        String
  code        String              @unique // PL, UCL, LL, SA, BL1
  type        CompetitionType     @default(LEAGUE)
  country     String
  logoUrl     String?
  orderIndex  Int                 @default(0)
  seasons     CompetitionSeason[]
  matches     Match[]
  articles    Article[]
  favoritedBy UserFavoriteCompetition[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([code])
  @@index([slug])
  @@map("competitions")
}

model CompetitionSeason {
  id            String            @id @default(cuid())
  competitionId String
  season        String // e.g., "2025/2026"
  startDate     DateTime?
  endDate       DateTime?
  isCurrent     Boolean           @default(false)
  competition   Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  standings     Standing[]
  matches       Match[]
  playerStats   PlayerStatistic[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([competitionId, season])
  @@index([competitionId])
  @@index([isCurrent])
  @@map("competition_seasons")
}

model Stadium {
  id        String   @id @default(cuid())
  name      String
  city      String
  capacity  Int?
  imageUrl  String?
  teams     Team[]
  matches   Match[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("stadiums")
}

model Team {
  id            String         @id @default(cuid())
  externalId    String?        @unique
  slug          String         @unique
  name          String
  shortName     String
  tla           String // 3-letter abbreviation: ARS, MCI, RMA
  country       String         @default("Global")
  foundedYear   Int?
  websiteUrl    String?
  logoUrl       String?
  stadiumId     String?
  stadium       Stadium?       @relation(fields: [stadiumId], references: [id], onDelete: SetNull)
  manager       Manager?
  players       Player[]
  homeMatches   Match[]        @relation("HomeTeamMatches")
  awayMatches   Match[]        @relation("AwayTeamMatches")
  standings     Standing[]
  fromTransfers Transfer[]     @relation("FromTeamTransfers")
  toTransfers   Transfer[]     @relation("ToTeamTransfers")
  lineups       MatchLineup[]
  events        MatchEvent[]
  articles      Article[]
  favoritedBy   UserFavoriteTeam[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([slug])
  @@index([tla])
  @@index([stadiumId])
  @@map("teams")
}

model Manager {
  id          String   @id @default(cuid())
  externalId  String?  @unique
  name        String
  slug        String   @unique
  nationality String
  photoUrl    String?
  teamId      String?  @unique
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@map("managers")
}

model Player {
  id           String            @id @default(cuid())
  externalId   String?           @unique
  slug         String            @unique
  name         String
  firstName    String?
  lastName     String?
  position     PlayerPosition
  shirtNumber  Int?
  nationality  String
  dateOfBirth  DateTime?
  photoUrl     String?
  teamId       String?
  team         Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  statistics   PlayerStatistic[]
  transfers    Transfer[]
  events       MatchEvent[]      @relation("PlayerEvents")
  assistEvents MatchEvent[]      @relation("AssistPlayerEvents")
  articles     Article[]
  favoritedBy  UserFavoritePlayer[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([slug])
  @@index([teamId])
  @@index([position])
  @@map("players")
}

model Match {
  id            String             @id @default(cuid())
  externalId    String?            @unique
  competitionId String
  seasonId      String?
  homeTeamId    String
  awayTeamId    String
  venueId       String?
  matchDate     DateTime
  status        MatchStatus        @default(SCHEDULED)
  minute        Int?
  homeScore     Int                @default(0)
  awayScore     Int                @default(0)
  htHomeScore   Int?
  htAwayScore   Int?
  round         String? // e.g. "Matchday 28", "Quarter-final"
  referee       String?
  competition   Competition        @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  season        CompetitionSeason? @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  homeTeam      Team               @relation("HomeTeamMatches", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam      Team               @relation("AwayTeamMatches", fields: [awayTeamId], references: [id], onDelete: Cascade)
  venue         Stadium?           @relation(fields: [venueId], references: [id], onDelete: SetNull)
  events        MatchEvent[]
  lineups       MatchLineup[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([competitionId])
  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([matchDate])
  @@index([status])
  @@map("matches")
}

model MatchEvent {
  id             String    @id @default(cuid())
  matchId        String
  teamId         String
  playerId       String?
  assistPlayerId String?
  minute         Int
  extraMinute    Int?
  type           EventType
  detail         String? // e.g. "Header", "Penalty", "Tactical sub"
  match          Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team           Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player         Player?   @relation("PlayerEvents", fields: [playerId], references: [id], onDelete: SetNull)
  assistPlayer   Player?   @relation("AssistPlayerEvents", fields: [assistPlayerId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([matchId])
  @@index([teamId])
  @@index([playerId])
  @@map("match_events")
}

model MatchLineup {
  id           String   @id @default(cuid())
  matchId      String
  teamId       String
  formation    String // e.g. "4-3-3", "3-4-2-1"
  startersJson Json // Array of { playerId, name, number, position, gridPosition }
  benchJson    Json // Array of { playerId, name, number, position }
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([matchId, teamId])
  @@index([matchId])
  @@index([teamId])
  @@map("match_lineups")
}

model Standing {
  id             String            @id @default(cuid())
  seasonId       String
  teamId         String
  position       Int
  played         Int               @default(0)
  won            Int               @default(0)
  drawn          Int               @default(0)
  lost           Int               @default(0)
  goalsFor       Int               @default(0)
  goalsAgainst   Int               @default(0)
  goalDifference Int               @default(0)
  points         Int               @default(0)
  form           String            @default("DDDDD") // e.g. "WWDLW"
  season         CompetitionSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  team           Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([seasonId, teamId])
  @@index([seasonId])
  @@index([position])
  @@map("standings")
}

model PlayerStatistic {
  id            String            @id @default(cuid())
  playerId      String
  seasonId      String
  appearances   Int               @default(0)
  goals         Int               @default(0)
  assists       Int               @default(0)
  yellowCards   Int               @default(0)
  redCards      Int               @default(0)
  minutesPlayed Int               @default(0)
  averageRating Decimal           @default(7.0) @db.Decimal(3, 1)
  player        Player            @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season        CompetitionSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([playerId, seasonId])
  @@index([playerId])
  @@index([seasonId])
  @@map("player_statistics")
}

model Transfer {
  id               String         @id @default(cuid())
  playerId         String
  fromTeamId       String?
  toTeamId         String?
  feeEur           Decimal?       @db.Decimal(14, 2)
  feeDescription   String? // e.g. "€65.0M", "Free Transfer", "Loan"
  transferType     TransferType   @default(PERMANENT)
  status           TransferStatus @default(RUMOR)
  announcementDate DateTime?
  contractUntil    String?
  player           Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fromTeam         Team?          @relation("FromTeamTransfers", fields: [fromTeamId], references: [id], onDelete: SetNull)
  toTeam           Team?          @relation("ToTeamTransfers", fields: [toTeamId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([playerId])
  @@index([fromTeamId])
  @@index([toTeamId])
  @@index([status])
  @@index([announcementDate])
  @@map("transfers")
}

// ==========================================
// 3. CONTRIBUTOR & EDITORIAL ENUMS & MODELS (SPRINT 3)
// ==========================================

enum ContributorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  BANNED
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ArticleStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  REVISION_REQUIRED
  REJECTED
  APPROVED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  IN_REVIEW
  REVISION_REQUIRED
  APPROVED
  REJECTED
  CANCELLED
}

enum ReviewDecision {
  APPROVE
  REQUEST_REVISION
  REJECT
}

enum SourceType {
  OFFICIAL
  INTERVIEW
  PRESS_RELEASE
  FOOTBALL_DATA
  NEWS_REPORT
  SOCIAL
  OTHER
}

enum ImageRightsStatus {
  OWNED
  LICENSED
  OFFICIAL_PRESS
  PUBLIC_DOMAIN
  PERMISSION_GRANTED
  UNKNOWN
}

enum NotificationType {
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  ARTICLE_SUBMITTED
  REVISION_REQUESTED
  ARTICLE_APPROVED
  ARTICLE_REJECTED
  ARTICLE_PUBLISHED
  REWARD_FINALIZED
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  PAYOUT_SENT
  PAYOUT_FAILED
  FRAUD_ALERT
  KYC_SUBMITTED
  KYC_VERIFIED
  KYC_REJECTED
  KYC_EXPIRED
  KYC_REVERIFICATION_REQUIRED
}

model ContributorProfile {
  id                 String               @id @default(cuid())
  userId             String               @unique
  slug               String               @unique
  displayName        String
  avatarUrl          String?
  bio                String?
  country            String
  preferredLanguage  String               @default("en")
  footballInterests  Json                 @default("[]") // Array of league codes/team slugs
  socialLinks        Json                 @default("{}") // Twitter, LinkedIn, etc.
  portfolioUrl       String?
  status             ContributorStatus    @default(ACTIVE)
  // Trust score foundations (Initialized safely for future Sprint 4/5 scoring algorithms)
  overallTrustScore  Decimal              @default(100.0) @db.Decimal(5, 2)
  accuracyScore      Decimal              @default(100.0) @db.Decimal(5, 2)
  originalityScore   Decimal              @default(100.0) @db.Decimal(5, 2)
  reliabilityScore   Decimal              @default(100.0) @db.Decimal(5, 2)
  copyrightScore     Decimal              @default(100.0) @db.Decimal(5, 2)
  qualityScore       Decimal              @default(100.0) @db.Decimal(5, 2)
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  articles           Article[]
  analytics          ContributorAnalytics[]
  wallet             Wallet?
  rewards            ContributorReward[]
  qualifiedViews     QualifiedView[]
  withdrawals        WithdrawalRequest[]
  payouts            Payout[]
  fraudSignals       FraudSignal[]
  financialAuditLogs FinancialAuditLog[]
  kyc                KycVerification?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([slug])
  @@index([status])
  @@map("contributor_profiles")
}

model ContributorApplication {
  id                  String            @id @default(cuid())
  userId              String?
  fullName            String
  displayName         String
  email               String
  country             String
  preferredLanguage   String            @default("en")
  footballInterests   String // Leagues/clubs of expertise
  preferredCategories String // e.g. "Tactical Analysis, Transfer Rumors"
  shortBio            String
  writingExperience   String
  portfolioUrl        String?
  socialUrl           String?
  agreementAccepted   Boolean           @default(true)
  originalityDeclared Boolean           @default(true)
  copyrightDeclared   Boolean           @default(true)
  status              ApplicationStatus @default(PENDING)
  reviewerNotes       String?
  reviewedByUserId    String?
  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([email])
  @@index([status])
  @@map("contributor_applications")
}

model ContributorAgreement {
  id         String   @id @default(cuid())
  userId     String
  version    String   @default("1.0")
  ipAddress  String?
  acceptedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("contributor_agreements")
}

model Article {
  id                   String                 @id @default(cuid())
  slug                 String                 @unique
  title                String
  subtitle             String?
  excerpt              String
  body                 String // Sanitized structured text/HTML
  featuredImageUrl     String?
  featuredImageCaption String?
  imageRightsStatus    ImageRightsStatus      @default(UNKNOWN)
  imageAttribution     String?
  imageSource          String?
  status               ArticleStatus          @default(DRAFT)
  gateStatus           GateStatus             @default(NOT_RUN)
  category             String // e.g. "Tactical Analysis", "Match Report", "Transfers"
  tags                 Json                   @default("[]") // Array of string tags
  seoTitle             String?
  seoDescription       String?
  wordCount            Int                    @default(0)
  readTimeMinutes      Int                    @default(1)
  isBreaking           Boolean                @default(false)
  isFeatured           Boolean                @default(false)
  authorId             String
  contributorProfileId String?
  competitionId        String?
  teamId               String?
  playerId             String?
  publishedAt          DateTime?
  author               User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  contributorProfile   ContributorProfile?    @relation(fields: [contributorProfileId], references: [id], onDelete: SetNull)
  competition          Competition?           @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  team                 Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull)
  player               Player?                @relation(fields: [playerId], references: [id], onDelete: SetNull)
  sources              ArticleSource[]
  revisions            ArticleRevision[]
  submissions          ArticleSubmission[]
  reviews              EditorialReview[]
  analytics            ContributorAnalytics[]
  gateRuns             EditorialGateRun[]
  overrideLogs         EditorialOverrideLog[]
  rewards              ContributorReward[]
  qualifiedViews       QualifiedView[]
  fraudSignals         FraudSignal[]
  articleAnalytics     ArticleAnalytics[]
  trendScore           ArticleTrendScore?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([slug])
  @@index([authorId])
  @@index([status])
  @@index([gateStatus])
  @@index([category])
  @@index([publishedAt])
  @@map("articles")
}

model ArticleSource {
  id         String     @id @default(cuid())
  articleId  String
  sourceName String
  sourceUrl  String
  sourceType SourceType @default(NEWS_REPORT)
  notes      String?
  article    Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())

  @@index([articleId])
  @@map("article_sources")
}

model ArticleRevision {
  id               String   @id @default(cuid())
  articleId        String
  revisionNumber   Int
  title            String
  body             String
  metadataSnapshot Json // Snapshot of subtitle, category, tags, sources, image rights
  changeSummary    String?
  createdByUserId  String
  article          Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([articleId, revisionNumber])
  @@index([articleId])
  @@map("article_revisions")
}

model ArticleSubmission {
  id             String            @id @default(cuid())
  articleId      String
  contributorId  String
  status         SubmissionStatus  @default(PENDING)
  notes          String?
  submittedAt    DateTime          @default(now())
  reviewedAt     DateTime?
  article        Article           @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviews        EditorialReview[]

  @@index([articleId])
  @@index([contributorId])
  @@index([status])
  @@map("article_submissions")
}

model EditorialReview {
  id                  String             @id @default(cuid())
  articleId           String
  submissionId        String?
  reviewerId          String
  decision            ReviewDecision
  internalNotes       String? // Private to Editorial staff & Admins
  contributorFeedback String? // Visible to the contributor
  article             Article            @relation(fields: [articleId], references: [id], onDelete: Cascade)
  submission          ArticleSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  reviewer            User               @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now())

  @@index([articleId])
  @@index([reviewerId])
  @@map("editorial_reviews")
}

model ContributorNotification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean          @default(false)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("contributor_notifications")
}

model ContributorAnalytics {
  id                   String              @id @default(cuid())
  contributorProfileId String
  articleId            String?
  viewsCount           Int                 @default(0)
  readTimeMinutesTotal Int                 @default(0)
  date                 DateTime            @default(now())
  contributorProfile   ContributorProfile  @relation(fields: [contributorProfileId], references: [id], onDelete: Cascade)
  article              Article?            @relation(fields: [articleId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())

  @@index([contributorProfileId])
  @@index([articleId])
  @@map("contributor_analytics")
}

// ==========================================
// 4. AI EDITORIAL GATE & COPYRIGHT PROTECTION (SPRINT 4)
// ==========================================

enum GateStatus {
  NOT_RUN
  CHECKING
  PASSED
  REVIEW
  REJECTED
}

enum FindingSeverity {
  PASS
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingCategory {
  ORIGINALITY
  SIMILARITY
  EXACT_PHRASE
  FACT_CHECK
  CLICKBAIT
  QUALITY
  IMAGE_RIGHTS
  IMAGE_DUPLICATE
  IMAGE_OCR
}

model EditorialGateRun {
  id               String             @id @default(cuid())
  articleId        String
  submissionId     String?
  status           GateStatus         @default(NOT_RUN)
  overallScore     Decimal            @default(100.0) @db.Decimal(5, 2)
  originalityScore Decimal            @default(100.0) @db.Decimal(5, 2)
  sourceScore      Decimal            @default(100.0) @db.Decimal(5, 2)
  factScore        Decimal            @default(100.0) @db.Decimal(5, 2)
  qualityScore     Decimal            @default(100.0) @db.Decimal(5, 2)
  clickbaitScore   Decimal            @default(100.0) @db.Decimal(5, 2)
  plagiarismRisk   FindingSeverity    @default(PASS)
  imageRisk        FindingSeverity    @default(PASS)
  provider         String             @default("mock")
  model            String?
  summary          String?
  findings         EditorialFinding[]
  article          Article            @relation(fields: [articleId], references: [id], onDelete: Cascade)
  startedAt        DateTime           @default(now())
  completedAt      DateTime?
  createdAt        DateTime           @default(now())

  @@index([articleId])
  @@index([status])
  @@map("editorial_gate_runs")
}

model EditorialFinding {
  id             String           @id @default(cuid())
  gateRunId      String
  category       FindingCategory
  severity       FindingSeverity
  finding        String
  evidence       String?
  sourceUrl      String?
  sourceTitle    String?
  matchedText    String?
  recommendation String?
  gateRun        EditorialGateRun @relation(fields: [gateRunId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@index([gateRunId])
  @@index([category])
  @@index([severity])
  @@map("editorial_findings")
}

model EditorialOverrideLog {
  id                 String         @id @default(cuid())
  articleId          String
  userId             String
  previousGateStatus GateStatus
  newDecision        ReviewDecision
  reason             String
  ipAddress          String?
  article            Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime       @default(now())

  @@index([articleId])
  @@index([userId])
  @@map("editorial_override_logs")
}

// ==========================================
// 5. CONTRIBUTOR REWARDS, WALLET, PAYOUT & FRAUD (SPRINT 5)
// ==========================================

enum Currency {
  MYR
  USD
  GBP
  EUR
}

enum QualifiedViewStatus {
  PENDING
  QUALIFIED
  REJECTED
  SUSPICIOUS
}

enum RewardStatus {
  PENDING
  CALCULATED
  FINALIZED
  CANCELLED
  REVERSED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
  REVERSAL
  ADJUSTMENT
  WITHDRAWAL_HOLD
  WITHDRAWAL_RELEASE
  PAYOUT
}

enum WithdrawalStatus {
  PENDING_REVIEW
  RISK_CHECKING
  AUTO_APPROVED
  MANUAL_REVIEW
  WITHDRAWAL_HOLD
  APPROVED
  PROCESSING
  PAID
  FAILED
  RETRY_PENDING
  REJECTED
  CANCELLED
}

enum PayoutStatus {
  PENDING_REVIEW
  APPROVED
  PROCESSING
  PAID
  FAILED
  REJECTED
  REVERSED
  RECONCILIATION_REQUIRED
}

enum PayoutAttemptStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum FraudSignalSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudSignalType {
  HIGH_VIEW_VELOCITY
  REPEATED_SESSION
  BOT_PATTERN
  DATACENTER_PATTERN
  SUSPICIOUS_USER_AGENT
  MULTIPLE_ACCOUNTS_PATTERN
  ABNORMAL_COUNTRY_PATTERN
  REFRESH_ABUSE
  AUTOMATED_TRAFFIC
}

enum FinancialAuditAction {
  REWARD_CALCULATED
  REWARD_FINALIZED
  WALLET_CREDIT
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_CANCELLED
  PAYOUT_CREATED
  PAYOUT_PROCESSING
  PAYOUT_PAID
  PAYOUT_FAILED
  ADJUSTMENT_CREATED
  FRAUD_FLAGGED
  PAYOUT_ACCOUNT_UPDATED
  AUTO_PAYOUT_TRIGGERED
  PAYOUT_RECONCILED
  PAYOUT_REVERSED
  WEBHOOK_RECEIVED
  POLICY_UPDATED
}

model QualifiedView {
  id                   String              @id @default(cuid())
  articleId            String
  contributorProfileId String
  sessionFingerprint   String // Anonymized/hashed session identifier
  ipHash               String? // Anonymized SHA-256 IP hash
  userAgentHash        String?
  status               QualifiedViewStatus @default(PENDING)
  rejectionReason      String?
  readTimeSeconds      Int                 @default(0)
  scrollDepthPercent   Int                 @default(0)
  isBot                Boolean             @default(false)
  rewardId             String?
  article              Article             @relation(fields: [articleId], references: [id], onDelete: Cascade)
  contributorProfile   ContributorProfile  @relation(fields: [contributorProfileId], references: [id], onDelete: Cascade)
  reward               ContributorReward?  @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  viewedAt             DateTime            @default(now())
  createdAt            DateTime            @default(now())

  @@index([articleId, status])
  @@index([contributorProfileId, status])
  @@index([sessionFingerprint, articleId])
  @@index([viewedAt])
  @@map("qualified_views")
}

model ContributorReward {
  id                   String               @id @default(cuid())
  contributorProfileId String
  articleId            String
  baseRewardMinor      Int                  @default(0) // Integer minor units (e.g. 500 = RM 5.00)
  viewBonusMinor       Int                  @default(0)
  qualityBonusMinor    Int                  @default(0)
  breakingBonusMinor   Int                  @default(0)
  totalRewardMinor     Int                  @default(0)
  qualifiedViewsCount  Int                  @default(0)
  qualityScore         Decimal              @default(0.0) @db.Decimal(5, 2)
  currency             Currency             @default(MYR)
  status               RewardStatus         @default(PENDING)
  calculationVersion   String               @default("reward_v1")
  calculationMetadata  Json?
  finalizedAt          DateTime?
  contributorProfile   ContributorProfile   @relation(fields: [contributorProfileId], references: [id], onDelete: Cascade)
  article              Article              @relation(fields: [articleId], references: [id], onDelete: Cascade)
  qualifiedViews       QualifiedView[]
  ledgerEntries        WalletLedgerEntry[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([contributorProfileId, articleId, calculationVersion])
  @@index([contributorProfileId, status])
  @@index([articleId])
  @@map("contributor_rewards")
}

model Wallet {
  id                         String               @id @default(cuid())
  contributorProfileId       String               @unique
  availableBalanceMinor      Int                  @default(0)
  heldBalanceMinor           Int                  @default(0) // Currently locked in pending withdrawal
  lifetimeEarningsMinor      Int                  @default(0)
  lifetimeWithdrawnMinor     Int                  @default(0)
  currency                   Currency             @default(MYR)
  payoutBankName             String?
  payoutAccountNumberMasked  String?
  payoutAccountHolderName    String?
  payoutAccountUpdatedAt     DateTime?
  payoutCooldownUntil        DateTime?
  contributorProfile         ContributorProfile   @relation(fields: [contributorProfileId], references: [id], onDelete: Cascade)
  ledgerEntries              WalletLedgerEntry[]
  withdrawals                WithdrawalRequest[]
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  @@index([contributorProfileId])
  @@map("wallets")
}

model WalletLedgerEntry {
  id                  String              @id @default(cuid())
  walletId            String
  type                LedgerEntryType
  amountMinor         Int // Positive integer minor unit
  currency            Currency            @default(MYR)
  balanceBeforeMinor  Int
  balanceAfterMinor   Int
  referenceId         String? // rewardId, withdrawalId, payoutId, or adjustmentId
  referenceType       String? // "REWARD", "WITHDRAWAL", "PAYOUT", "ADJUSTMENT", "REVERSAL"
  reason              String
  actorId             String? // Admin/system user ID
  rewardId            String?
  withdrawalId        String?
  wallet              Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  reward              ContributorReward?  @relation(fields: [rewardId], references: [id], onDelete: SetNull)
  withdrawal          WithdrawalRequest?  @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())

  @@index([walletId, createdAt])
  @@index([referenceId])
  @@map("wallet_ledger_entries")
}

model WithdrawalRequest {
  id                   String              @id @default(cuid())
  walletId             String
  contributorProfileId String
  amountMinor          Int
  currency             Currency            @default(MYR)
  status               WithdrawalStatus    @default(PENDING_REVIEW)
  idempotencyKey       String?             @unique
  rejectionReason      String?
  bankName             String
  accountNumberMasked  String
  accountHolderName    String
  reviewedByUserId     String?
  reviewedAt           DateTime?
  wallet               Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  contributorProfile   ContributorProfile  @relation(fields: [contributorProfileId], references: [id], onDelete: Cascade)
  payout               Payout?
  ledgerEntries        WalletLedgerEntry[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([walletId])
  @@index([contributorProfileId, status])
  @@index([status])
  @@map("withdrawal_requests")
}

model Payout {
  id                   String              @id @default(cuid())
  withdrawalRequestId  String              @unique
  contributorProfileId String
  amountMinor          Int
  currency             Currency            @default(MYR)
  status               PayoutStatus        @default(PENDING_REVIEW)
  provider             String              @default("mock") // "mock-payout-provider"
  providerReference    String?
  approvedByUserId     String?
  processedByUserId    String?
  failureReason        String?
  withdrawalRequest    WithdrawalRequest   @relation(fields: [withdrawalRequestId], references: [id], onDelete: Cascade)
  contributorProfile   ContributorProfile  @relation(fields: [contributorProfileId], references: [id], onDelete: Cascade)
  attempts             PayoutAttempt[]
  paidAt               DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([contributorProfileId, status])
  @@index([status])
  @@map("payouts")
}

model PayoutAttempt {
  id                String              @id @default(cuid())
  payoutId          String
  attemptNumber     Int                 @default(1)
  provider          String              @default("mock")
  providerReference String?
  amountMinor       Int
  currency          Currency            @default(MYR)
  status            PayoutAttemptStatus @default(PENDING)
  errorCode         String?
  errorMessage      String?
  payout            Payout              @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  startedAt         DateTime            @default(now())
  completedAt       DateTime?
  createdAt         DateTime            @default(now())

  @@index([payoutId])
  @@map("payout_attempts")
}

model FraudSignal {
  id                   String              @id @default(cuid())
  contributorProfileId String
  articleId            String?
  signalType           FraudSignalType
  severity             FraudSignalSeverity @default(LOW)
  riskScore            Int                 @default(0) // 0 to 100
  evidence             String
  metadata             Json?
  isResolved           Boolean             @default(false)
  resolvedByUserId     String?
  resolutionNotes      String?
  contributorProfile   ContributorProfile  @relation(fields: [contributorProfileId], references: [id], onDelete: Cascade)
  article              Article?            @relation(fields: [articleId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([contributorProfileId, isResolved])
  @@index([severity])
  @@map("fraud_signals")
}

model FinancialAuditLog {
  id                   String                @id @default(cuid())
  action               FinancialAuditAction
  actorId              String? // User ID who performed action
  contributorProfileId String?
  entityType           String // "REWARD", "WALLET", "WITHDRAWAL", "PAYOUT", "ADJUSTMENT", "FRAUD"
  entityId             String
  amountMinor          Int?
  currency             Currency?             @default(MYR)
  previousState        Json?
  newState             Json?
  reason               String?
  ipAddress            String?
  userAgent            String?
  contributorProfile   ContributorProfile?   @relation(fields: [contributorProfileId], references: [id], onDelete: SetNull)
  createdAt            DateTime              @default(now())

  @@index([action])
  @@index([actorId])
  @@index([contributorProfileId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("financial_audit_logs")
}

